    "TerraWrath"
  ],
  "license": "MIT",
  "icon": "assets/terrawrath/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.terrawrath.fabric.TerraWrathFabric"
    ],
    "client": [
      "com.terrawrath.fabric.TerraWrathFabricClient"
    ]
  },
  "mixins": [
    "terrawrath.fabricshared.mixins.json",
    "terrawrath.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
